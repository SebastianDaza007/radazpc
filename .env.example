# Opcional: CSV publicado (WEB o lista actual). Tiene prioridad sobre PRICES_SHEET_ID/GID.
# Si la lectura falla, se usa src/lib/services.fallback.ts.
PRICES_CSV_URL=
PRICES_SHEET_ID=
PRICES_SHEET_GID=

# --- Indicadores (uso interno, solo servidor) ---
# Sin las tres variables ADMIN_* el panel privado queda deshabilitado.
# Generar con npm run admin:setup. Copiar estas tres variables al hosting para producción.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# ID de la planilla (no va en el repo: el enlace es publico). La planilla debe poder leerse por enlace.
INDICATORS_SHEET_ID=
# Opcional. Pestañas separadas por coma, de la mas vieja a la mas nueva (ej: RP-08-24,RP-09-24,RP-5-25).
# Si falta, se generan RP-MM-AA y RP-M-AA desde 08-24 hasta el mes actual; las que no existen se saltean y "Trabajos" se excluye.
INDICATORS_SHEET_TABS=
# "sample" usa datos inventados (desarrollo local).
INDICATORS_SOURCE=
